# Desenvolvimento: o navegador chama /api e o Vite encaminha para este servidor.
API_PROXY_TARGET=https://pede-gas-api.onrender.com

# Produção: defina a URL pública da API. O domínio do site precisa estar liberado
# no CORS_ORIGIN do backend. Nenhuma destas variáveis pode conter segredos.
# VITE_API_URL=https://pede-gas-api.onrender.com

# Opcional: endpoint próprio/provedor de geocodificação reversa compatível com
# Nominatim (recebe lat, lon e format=jsonv2; responde { address: { ... } }).
# Sem ele, o GPS mostra coordenadas e o usuário preenche o endereço manualmente.
# Use um provedor com limites, CORS e privacidade adequados ao seu tráfego.
# VITE_REVERSE_GEOCODING_URL=https://seu-provedor/reverse
